    {
      "name": "Создание нового комментария",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Статус код должен быть 201 и данные в формате JSON\", function () {",
              "    pm.response.to.have.status(201);",
              "    pm.response.to.be.json;",
              "});",
              "",
              "const json = pm.response.json();",
              "",
              "pm.test(\"Данные сохранены корректно\", function () {",
              "    pm.expect(json.id).to.be.a(\"number\");",
              "    pm.expect(json.text).to.include(\"comment\");",
              "    pm.expect(json.author.id).to.eql(1);",
              "    pm.expect(json.event.id).to.eql(1);",
              "});",
              "",
              "pm.collectionVariables.set(\"createdCommentId\", json.id);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
